{
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 16 * * *"
            }
          ]
        }
      },
      "id": "daily-trigger",
      "name": "Daily Analysis Trigger",
      "type": "n8n-nodes-base.cron",
      "position": [100, 300],
      "typeVersion": 1
    },
    {
      "parameters": {
        "operation": "select",
        "table": "tech_news_articles",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "created_at",
              "condition": "dateAfter",
              "value": "={{ new Date(Date.now() - 24*60*60*1000).toISOString() }}"
            }
          ]
        },
        "options": {
          "queryName": "orderBy",
          "queryValue": "created_at.desc"
        }
      },
      "id": "fetch-recent-news",
      "name": "Fetch Recent News",
      "type": "n8n-nodes-base.supabase",
      "position": [300, 300],
      "typeVersion": 1,
      "credentials": {
        "supabaseApi": {
          "id": "supabase-credentials",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "resource": "text",
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gemini-2.0-flash-exp"
        },
        "prompt": "=Analyze this tech news article and provide:\n1. Importance score (0-100) based on:\n   - Innovation level\n   - Industry impact\n   - Global relevance\n   - Business implications\n   - Trending potential\n\n2. LinkedIn post content (max 280 chars) with:\n   - Engaging hook\n   - Key insight\n   - Relevant hashtags\n   - Professional tone\n\nArticle:\nTitle: {{ $json.title }}\nContent: {{ $json.content }}\nCategory: {{ $json.category }}\n\nRespond in JSON format:\n{\n  \"score\": 85,\n  \"linkedin_post\": \"🚀 Revolutionary AI breakthrough...\",\n  \"reasoning\": \"High impact due to...\"\n}",
        "options": {
          "temperature": 0.3,
          "maxTokens": 500
        }
      },
      "id": "ai-analysis",
      "name": "AI Analysis & Content Generation",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "position": [500, 300],
      "typeVersion": 1,
      "credentials": {
        "googleGeminiOAuth2Api": {
          "id": "gemini-credentials",
          "name": "Google Gemini API"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ JSON.parse($json.response).score }}",
              "operation": "largerEqual",
              "value2": 70
            }
          ]
        }
      },
      "id": "filter-high-score",
      "name": "Filter High Score Articles",
      "type": "n8n-nodes-base.if",
      "position": [700, 300],
      "typeVersion": 2
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "linkedin_posts",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "article_id": "={{ $('Fetch Recent News').item.json.id }}",
            "ai_score": "={{ JSON.parse($('AI Analysis & Content Generation').item.json.response).score }}",
            "suggested_content": "={{ JSON.parse($('AI Analysis & Content Generation').item.json.response).linkedin_post }}",
            "status": "pending",
            "created_at": "={{ new Date().toISOString() }}"
          }
        },
        "options": {}
      },
      "id": "save-linkedin-posts",
      "name": "Save LinkedIn Posts",
      "type": "n8n-nodes-base.supabase",
      "position": [900, 200],
      "typeVersion": 1,
      "credentials": {
        "supabaseApi": {
          "id": "supabase-credentials",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "operation": "select",
        "table": "linkedin_posts",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "equal",
              "value": "pending"
            },
            {
              "keyName": "created_at",
              "condition": "dateAfter", 
              "value": "={{ new Date(Date.now() - 60*60*1000).toISOString() }}"
            }
          ]
        },
        "options": {
          "queryName": "orderBy",
          "queryValue": "ai_score.desc"
        }
      },
      "id": "get-pending-posts",
      "name": "Get Pending Posts",
      "type": "n8n-nodes-base.supabase",
      "position": [1100, 200],
      "typeVersion": 1,
      "credentials": {
        "supabaseApi": {
          "id": "supabase-credentials",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=🤖 **Günlük LinkedIn Analizi**\n\n📊 **{{ $('Get Pending Posts').all().length }} yeni post hazır**\n\n{{ $('Get Pending Posts').all().map((item, index) => `📝 **Post ${index + 1}** (Score: ${item.json.ai_score})\n${item.json.suggested_content}\n`).join('\\n') }}\n\n👆 Yukarıdaki postları onaylamak için butona tıklayın:",
        "additionalFields": {
          "replyMarkup": {
            "inlineKeyboard": {
              "rows": [
                {
                  "buttons": [
                    {
                      "text": "🚀 HEPSINI OTOMATIK PAYLAŞ",
                      "callbackData": "approve_all_auto"
                    }
                  ]
                },
                {
                  "buttons": [
                    {
                      "text": "✅ MANUEL PAYLAŞACAĞIM",
                      "callbackData": "approve_manual"
                    },
                    {
                      "text": "❌ İPTAL ET",
                      "callbackData": "reject_all"
                    }
                  ]
                }
              ]
            }
          }
        }
      },
      "id": "send-telegram-approval",
      "name": "Send Telegram Approval",
      "type": "n8n-nodes-base.telegram",
      "position": [1300, 200],
      "typeVersion": 1.2,
      "credentials": {
        "telegramApi": {
          "id": "telegram-credentials",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "path": "linkedin-approval",
        "httpMethod": "POST",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "approval-webhook",
      "name": "Approval Webhook",
      "type": "n8n-nodes-base.webhook",
      "position": [100, 600],
      "typeVersion": 1,
      "webhookId": "linkedin-approval-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.callback_data }}",
              "operation": "equal",
              "value2": "approve_all_auto"
            }
          ]
        }
      },
      "id": "check-auto-approval",
      "name": "Check Auto Approval",
      "type": "n8n-nodes-base.if",
      "position": [300, 600],
      "typeVersion": 2
    },
    {
      "parameters": {
        "operation": "select",
        "table": "linkedin_posts",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "equal",
              "value": "pending"
            }
          ]
        },
        "options": {}
      },
      "id": "get-approved-posts",
      "name": "Get Approved Posts",
      "type": "n8n-nodes-base.supabase",
      "position": [500, 500],
      "typeVersion": 1,
      "credentials": {
        "supabaseApi": {
          "id": "supabase-credentials",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "table": "linkedin_posts",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "equal",
              "value": "pending"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "approved",
            "approved_content": "={{ $json.suggested_content }}"
          }
        },
        "options": {}
      },
      "id": "update-to-approved",
      "name": "Update to Approved",
      "type": "n8n-nodes-base.supabase",
      "position": [700, 500],
      "typeVersion": 1,
      "credentials": {
        "supabaseApi": {
          "id": "supabase-credentials",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "text": "={{ $json.approved_content }}",
        "additionalFields": {}
      },
      "id": "linkedin-post",
      "name": "LinkedIn Post",
      "type": "n8n-nodes-base.linkedIn",
      "position": [900, 500],
      "typeVersion": 1,
      "credentials": {
        "linkedInOAuth2Api": {
          "id": "linkedin-credentials",
          "name": "LinkedIn Account"
        }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "table": "linkedin_posts",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "equal",
              "value": "={{ $('Get Approved Posts').item.json.id }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "posted",
            "posted_at": "={{ new Date().toISOString() }}",
            "linkedin_post_id": "={{ $json.id }}"
          }
        },
        "options": {}
      },
      "id": "update-posted-status",
      "name": "Update Posted Status",
      "type": "n8n-nodes-base.supabase",
      "position": [1100, 500],
      "typeVersion": 1,
      "credentials": {
        "supabaseApi": {
          "id": "supabase-credentials",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=✅ **LinkedIn Paylaşımı Tamamlandı!**\n\n📝 **İçerik:** {{ $('Get Approved Posts').item.json.approved_content.substring(0, 100) }}...\n\n🔗 **LinkedIn Post ID:** {{ $('LinkedIn Post').item.json.id }}\n⏰ **Zaman:** {{ new Date().toLocaleString('tr-TR') }}",
        "additionalFields": {}
      },
      "id": "success-notification",
      "name": "Success Notification",
      "type": "n8n-nodes-base.telegram",
      "position": [1300, 500],
      "typeVersion": 1.2,
      "credentials": {
        "telegramApi": {
          "id": "telegram-credentials",
          "name": "Telegram Bot"
        }
      }
    }
  ],
