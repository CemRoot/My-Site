      "id": "3dd6f9f0-ee4a-4128-a0dd-c6674e025344",
      "name": "Webhook Trigger (Manual + Callbacks)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -2336,
        336
      ],
      "webhookId": "webhook-unified-id",
      "notesInFlow": true,
      "notes": "Handles both manual triggers and Telegram callbacks"
