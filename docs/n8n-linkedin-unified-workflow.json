    {
      "parameters": {
        "jsCode": "// Get the digest data from Fetch Digest by ID node\nconst digest = $('Fetch Digest by ID').first().json;\n\n// Get edited_content if exists, otherwise use suggested_content\nconst content = digest.edited_content || digest.suggested_content;\n\n// Check if content exists\nif (!content) {\n  throw new Error('No content found in digest');\n}\n\n// Remove markdown bold syntax (**text** → text)\nconst cleanContent = content.replace(/\\*\\*(.*?)\\*\\*/g, '$1');\n\n// Return all data with clean_content added\nreturn {\n  json: {\n    ...digest,\n    clean_content: cleanContent\n  }\n};"
      },
