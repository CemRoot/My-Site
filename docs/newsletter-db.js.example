/**
 * Newsletter Database using Vercel KV (Redis)
 * Secure, serverless, and free tier: 256 MB
 */

import { kv } from '@vercel/kv';

const NEWSLETTER_KEY = 'newsletter:subscribers';

/**
 * Add email to newsletter
 */
export async function addSubscriber(email) {
  try {
    // Check if already exists
    const exists = await kv.sismember(NEWSLETTER_KEY, email);
    if (exists) {
      return { success: false, message: 'Email already subscribed' };
    }

    // Add to set
    await kv.sadd(NEWSLETTER_KEY, email);
    
    // Also store with metadata
    await kv.hset(`newsletter:subscriber:${email}`, {
      email,
      subscribedAt: new Date().toISOString(),
      source: 'website'
    });

    return { success: true, message: 'Subscribed successfully' };
  } catch (error) {
    console.error('Newsletter DB error:', error);
    return { success: false, message: 'Database error' };
  }
}

/**
 * Get all subscribers (for admin only)
 */
export async function getAllSubscribers() {
  try {
    return await kv.smembers(NEWSLETTER_KEY);
  } catch (error) {
    console.error('Newsletter DB error:', error);
    return [];
  }
}

/**
 * Remove subscriber
 */
export async function removeSubscriber(email) {
  try {
    await kv.srem(NEWSLETTER_KEY, email);
    await kv.del(`newsletter:subscriber:${email}`);
    return { success: true };
  } catch (error) {
    console.error('Newsletter DB error:', error);
    return { success: false };
  }
}

/**
 * Get subscriber count
 */
export async function getSubscriberCount() {
  try {
    return await kv.scard(NEWSLETTER_KEY);
  } catch (error) {
    console.error('Newsletter DB error:', error);
    return 0;
  }
}

