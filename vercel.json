{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/tech-news/:slug",
      "destination": "/api/seo-page?kind=article&slug=:slug"
    },
    {
      "source": "/finance",
      "destination": "https://broker.cemkoyluoglu.codes/finance"
    },
    {
      "source": "/finance/:path*",
      "destination": "https://broker.cemkoyluoglu.codes/finance/:path*"
    },
    {
      "source": "/public/live",
      "destination": "https://broker.cemkoyluoglu.codes/public/live"
    },
    {
      "source": "/health",
      "destination": "https://broker.cemkoyluoglu.codes/health"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/privacy/",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/tech-news",
      "destination": "/api/seo-page?kind=list"
    },
    {
      "source": "/english-learning",
      "destination": "/english-learning/index.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo-page?kind=sitemap"
    },
    {
      "source": "/:path((?!robots\\.txt|7fdb15710394252f5593bc2fc34e78af\\.txt|sitemap\\.xml|llms\\.txt|llms-full\\.txt|tech-news-latest\\.json|app-shell\\.html|favicon\\.ico|favicon\\.webp|og-image\\.png|og-image\\.webp|portrait\\.webp|assets|fonts|models\\/|yt-ai-summarizer\\/|privacy\\/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/privacy",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300"
        }
      ]
    },
    {
      "source": "/privacy/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/tech-news-latest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=60, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://vercel.live https://va.vercel-scripts.com https://www.googletagmanager.com https://platform.twitter.com https://www.tiktok.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://api.fontshare.com; img-src 'self' data: https: blob:; font-src 'self' data: https://fonts.googleapis.com https://fonts.gstatic.com https://api.fontshare.com https://cdn.fontshare.com; connect-src 'self' https://*.supabase.co https://api.groq.com https://api.firecrawl.dev https://api.telegram.org https://*.ingest.de.sentry.io https://*.sentry.io https://platform.twitter.com https://syndication.twitter.com; frame-src 'self' https://www.youtube.com https://platform.twitter.com https://www.tiktok.com; media-src 'self' https: blob:;"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://vercel.live https://va.vercel-scripts.com https://www.googletagmanager.com https://platform.twitter.com https://www.tiktok.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://api.fontshare.com; img-src 'self' data: https: blob:; font-src 'self' data: https://fonts.googleapis.com https://fonts.gstatic.com https://api.fontshare.com https://cdn.fontshare.com; connect-src 'self' https://*.supabase.co https://api.groq.com https://api.firecrawl.dev https://api.telegram.org https://*.ingest.de.sentry.io https://*.sentry.io https://platform.twitter.com https://syndication.twitter.com; frame-src 'self' https://www.youtube.com https://platform.twitter.com https://www.tiktok.com; media-src 'self' https: blob:;"
        }
      ]
    },
    {
      "source": "/api/tech-news",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=30, s-maxage=60, stale-while-revalidate=120"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=60"
        }
      ]
    }
  ],
  "functions": {
    "api/chat.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/telegram-webhook.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/seo-page.js": {
      "memory": 1024,
      "maxDuration": 15,
      "includeFiles": "build/app-shell.html"
    }
  }
}
