# Dependencies
node_modules/
.pnp
.pnp.js

# Testing (local only — not published to GitHub)
tests/
coverage/

# Scraper run artifacts & local diagnostics (may contain URLs/titles from production)
artifacts/

# Production
build/
dist/

# Generated at build time (Supabase slugs + dated lastmod); avoids daily git churn
public/sitemap.xml
public/tech-news-latest.json
public/optimized/

# Misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories
.idea/
.vscode/
*.swp
*.swo
*~

# Vercel local link metadata. Ignore the whole directory — project.json holds
# projectId/orgId, and the rest is generated boilerplate with no value in VCS.
.vercel/

# Local agent/working notes — never publish. Contains environment paths,
# debugging transcripts and in-progress decisions, none of it useful to a reader
# of this repository.
memory.md

# Supabase CLI local cache (e.g. cli-latest version check)
supabase/.temp/

# macOS / editor accidental duplicate copies (e.g. "chat 2.js")
**/* 2.js
**/* 2.ts
**/* 2.tsx
**/* 2.mjs

# Temporary files
scripts/test-translation.js
.tmp/

# Private data
.env*.local
# Security scan reports - contain sensitive data
gitleaks-report.json
npm-audit-report.json
semgrep-report.json
snyk-report.json
*-report.json
