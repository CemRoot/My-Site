tests/
coverage/

# Scraper run artifacts & local diagnostics (may contain URLs/titles from production)
artifacts/

# Production
build/
dist/

# Generated at build time (Supabase slugs + dated lastmod); avoids daily git churn
public/sitemap.xml
public/optimized/

# Misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories
.idea/
.vscode/
*.swp
*.swo
*~

# Vercel project metadata (contains projectId/orgId – do not commit)
.vercel/project.json
.vercel/.vc-config.json

# macOS / editor accidental duplicate copies (e.g. "chat 2.js")
**/* 2.js
**/* 2.ts
**/* 2.tsx
**/* 2.mjs

# Temporary files
scripts/test-translation.js

# Private data
data/newsletter-subscribers.json
.env*.local
# Security scan reports - contain sensitive data
gitleaks-report.json
npm-audit-report.json
semgrep-report.json
snyk-report.json
*-report.json
