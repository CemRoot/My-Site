{
      "name": "Luxury Portfolio Website",
      "version": "0.1.0",
      "private": true,
      "type": "module",
      "dependencies": {
            "@emailjs/browser": "^4.4.1",
            "@radix-ui/react-checkbox": "^1.3.5",
            "@radix-ui/react-dialog": "^1.1.17",
            "@radix-ui/react-separator": "^1.1.10",
            "@radix-ui/react-slot": "^1.3.0",
            "@sentry/node": "^10.59.0",
            "@sentry/react": "^10.59.0",
            "@sentry/vite-plugin": "^5.3.0",
            "@supabase/supabase-js": "^2.108.2",
            "@vercel/analytics": "^2.0.1",
            "@vercel/speed-insights": "^2.0.0",
            "cheerio": "^1.2.0",
            "class-variance-authority": "^0.7.1",
            "clsx": "*",
            "dotenv": "^17.4.2",
            "groq-sdk": "^1.2.1",
            "lucide-react": "^1.21.0",
            "next-themes": "^0.4.6",
            "ollama": "^0.6.3",
            "react": "^19.2.7",
            "react-dom": "^19.2.7",
            "react-markdown": "^10.1.0",
            "react-router-dom": "^7.18.0",
            "remark-gfm": "^4.0.1",
            "sonner": "^2.0.7",
            "tailwind-merge": "^3.6.0",
            "typescript": "^6.0.3",
            "ws": "^8.21.0",
            "xml2js": "^0.6.2"
      },
      "devDependencies": {
            "@types/node": "^20.10.0",
            "@vitejs/plugin-react-swc": "^4.3.1",
            "terser": "^5.48.0",
            "vite": "^8.0.16"
      },
      "overrides": {
            "picomatch": "4.0.4",
            "anymatch": {
                  "picomatch": "2.3.2"
            },
            "readdirp": {
                  "picomatch": "2.3.2"
            },
            "brace-expansion": "2.0.3",
            "next": "16.2.9",
            "undici": "7.28.0",
            "postcss": "8.5.16"
      },
      "scripts": {
            "test": "node --test tests/rate-limit.test.js tests/chat-security.test.js tests/format-tech-news-article.test.mjs tests/preflight-url-utils.test.mjs tests/telegram-html-escape.test.mjs tests/telegram-tech-news-success-message.test.mjs tests/slug-normalization.test.mjs tests/use-tech-news-loading-regression.test.mjs tests/scrape-tech-news-schedule.test.mjs",
            "dev": "vite",
            "prebuild": "node scripts/sitemap-generator.js && node scripts/generate-tech-news-snapshot.js",
            "build": "vite build",
            "postbuild": "node scripts/prerender-static-shells.js && (node scripts/post-build-telegram.js || true)",
            "sitemap": "node scripts/sitemap-generator.js",
            "snapshot:news": "node scripts/generate-tech-news-snapshot.js",
            "scrape:news": "node --max-old-space-size=4096 scripts/news-scraper.js",
            "scrape:news:parity": "node scripts/ci/tech-news-preflight.mjs && node scripts/ci/run-scrape-if-preflight-ok.mjs",
            "scrape:news:replay": "node --max-old-space-size=4096 scripts/news-scraper.js --replay-status rejected,failed,deleted",
            "linkedin:analyze": "node scripts/daily-linkedin-automation.js analyze",
            "linkedin:post": "node scripts/daily-linkedin-automation.js post",
            "linkedin:test": "node scripts/daily-linkedin-automation.js test",
            "linkedin:groups": "node scripts/linkedin-groups-digest.js daily",
            "linkedin:groups-weekly": "node scripts/linkedin-groups-digest.js weekly",
            "linkedin:analyze-force": "MIN_AI_SCORE=50 node scripts/daily-linkedin-automation.js analyze",
            "telegram:webhook-setup": "node scripts/setup-telegram-webhook.js set",
            "telegram:webhook-remove": "node scripts/setup-telegram-webhook.js remove",
            "telegram:reset": "node scripts/reset-telegram-webhook.js reset",
            "telegram:check": "node scripts/reset-telegram-webhook.js check",
            "telegram:setup-menu": "node scripts/setup-telegram-menu.js",
            "n8n:status": "node scripts/n8n-trial-status.js status",
            "n8n:check": "node scripts/n8n-trial-status.js",
            "n8n:reset": "node scripts/n8n-trial-status.js reset",
            "health:check": "node scripts/system-health-check.js",
            "vercel:status": "node scripts/vercel-status-monitor.js",
            "cleanup:db": "node scripts/cleanup-tech-news.js",
            "cleanup:duplicates": "node scripts/cleanup-duplicates.js",
            "cleanup:duplicates:dry": "node scripts/cleanup-duplicates.js --dry-run"
      }
}
