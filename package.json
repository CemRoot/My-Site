{
      "name": "Luxury Portfolio Website",
      "version": "0.1.0",
      "private": true,
      "type": "module",
      "dependencies": {
            "@emailjs/browser": "^4.4.1",
            "@radix-ui/react-checkbox": "^1.1.4",
            "@radix-ui/react-dialog": "^1.1.6",
            "@radix-ui/react-separator": "^1.1.2",
            "@radix-ui/react-slot": "^1.1.2",
            "@sentry/node": "^7.119.0",
            "@sentry/react": "^7.119.0",
            "@sentry/tracing": "^7.119.0",
            "@sentry/vite-plugin": "^2.22.0",
            "@supabase/supabase-js": "^2.75.0",
            "@vercel/analytics": "^1.5.0",
            "@vercel/speed-insights": "^1.2.0",
            "cheerio": "^1.1.2",
            "class-variance-authority": "^0.7.1",
            "clsx": "*",
            "dotenv": "^17.2.3",
            "groq-sdk": "^0.33.0",
            "lucide-react": "^0.548.0",
            "next-themes": "^0.4.6",
            "ollama": "^0.6.3",
            "react": "^18.3.1",
            "react-dom": "^18.3.1",
            "react-markdown": "^10.1.0",
            "react-router-dom": "^7.9.4",
            "remark-gfm": "^4.0.1",
            "sonner": "^2.0.3",
            "tailwind-merge": "*",
            "typescript": "^5.9.3",
            "xml2js": "^0.6.2"
      },
      "devDependencies": {
            "@types/node": "^20.10.0",
            "@vitejs/plugin-react-swc": "^3.10.2",
            "terser": "^5.44.0",
            "vite": "^6.4.1"
      },
      "scripts": {
            "test": "node --test tests/rate-limit.test.js tests/format-tech-news-article.test.mjs tests/preflight-url-utils.test.mjs tests/telegram-html-escape.test.mjs tests/telegram-tech-news-success-message.test.mjs",
            "dev": "vite",
            "build": "vite build",
            "postbuild": "node scripts/sitemap-generator.js && node scripts/post-build-telegram.js || true",
            "scrape:news": "node --max-old-space-size=4096 scripts/news-scraper.js",
            "scrape:news:parity": "node scripts/ci/tech-news-preflight.mjs && node scripts/ci/run-scrape-if-preflight-ok.mjs",
            "scrape:news:replay": "node --max-old-space-size=4096 scripts/news-scraper.js --replay-status rejected,failed,deleted",
            "linkedin:analyze": "node scripts/daily-linkedin-automation.js analyze",
            "linkedin:post": "node scripts/daily-linkedin-automation.js post",
            "linkedin:test": "node scripts/daily-linkedin-automation.js test",
            "linkedin:groups": "node scripts/linkedin-groups-digest.js daily",
            "linkedin:groups-weekly": "node scripts/linkedin-groups-digest.js weekly",
            "linkedin:analyze-force": "MIN_AI_SCORE=50 node scripts/daily-linkedin-automation.js analyze",
            "telegram:webhook-setup": "node scripts/setup-telegram-webhook.js set",
            "telegram:webhook-remove": "node scripts/setup-telegram-webhook.js remove",
            "telegram:reset": "node scripts/reset-telegram-webhook.js reset",
            "telegram:check": "node scripts/reset-telegram-webhook.js check",
            "telegram:setup-menu": "node scripts/setup-telegram-menu.js",
            "n8n:status": "node scripts/n8n-trial-status.js status",
            "n8n:check": "node scripts/n8n-trial-status.js",
            "n8n:reset": "node scripts/n8n-trial-status.js reset",
            "health:check": "node scripts/system-health-check.js",
            "vercel:status": "node scripts/vercel-status-monitor.js",
            "cleanup:db": "node scripts/cleanup-tech-news.js",
            "cleanup:duplicates": "node scripts/cleanup-duplicates.js",
            "cleanup:duplicates:dry": "node scripts/cleanup-duplicates.js --dry-run"
      }
}
