{
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression", 
              "expression": "30 16 * * *"
            }
          ]
        }
      },
      "id": "daily-trigger",
      "name": "Daily Content Trigger",
      "type": "n8n-nodes-base.cron",
      "position": [100, 300],
      "typeVersion": 1
    },
    {
      "parameters": {
        "operation": "select",
        "table": "tech_news_articles",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "created_at",
              "condition": "dateEquals",
              "value": "={{ new Date().toISOString().split('T')[0] }}"
            }
          ]
        },
        "options": {
          "queryName": "orderBy",
          "queryValue": "created_at.desc",
          "limit": 7
        }
      },
      "id": "get-todays-news",
      "name": "Get Today's News",
      "type": "n8n-nodes-base.supabase",
      "position": [300, 300],
      "typeVersion": 1,
      "credentials": {
        "supabaseApi": {
          "id": "supabase-credentials",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "resource": "text",
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gemini-2.0-flash-exp"
        },
        "prompt": "=Bu tech haber için LinkedIn post oluştur. KURALLARI SIKI TAKİP ET:\n\n📋 KURALLAR:\n• İlgi çekici ama haber dışına çıkmayan başlık\n• 2-3 cümle özet (maksimum 280 karakter)\n• Site linki: https://cemkoyluoglu.codes/news/{{ $json.slug }}\n• Uygun hashtag'ler (3-5 adet)\n• LinkedIn formatting: **bold** ve *italic* kullan\n• Türkçe değil İNGİLİZCE yaz\n\n📰 HABER:\nBaşlık: {{ $json.title }}\nİçerik: {{ $json.content }}\nKategori: {{ $json.category }}\n\nÖRNEK FORMAT:\n**OpenAI Launches Revolutionary GPT-5 Model** 🚀\n\nArtificial intelligence reaches new heights with advanced reasoning capabilities and multimodal processing. This breakthrough promises to transform how we interact with AI systems.\n\n🔗 Read more: https://cemkoyluoglu.codes/news/openai-gpt5\n\n#AI #OpenAI #GPT5 #Technology #Innovation\n\nSADECE POST İÇERİĞİNİ DÖNDÜR, BAŞKA BİR ŞEY YAZMA:",
        "options": {
          "temperature": 0.4,
          "maxTokens": 400
        }
      },
      "id": "generate-linkedin-content",
      "name": "Generate LinkedIn Content",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "position": [500, 300],
      "typeVersion": 1,
      "credentials": {
        "googleGeminiOAuth2Api": {
          "id": "gemini-credentials",
          "name": "Google Gemini API"
        }
      }
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "linkedin_posts",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "article_id": "={{ $('Get Today\\'s News').item.json.id }}",
            "suggested_content": "={{ $json.response }}",
            "status": "pending",
            "created_at": "={{ new Date().toISOString() }}"
          }
        },
        "options": {}
      },
      "id": "save-generated-posts",
      "name": "Save Generated Posts",
      "type": "n8n-nodes-base.supabase",
      "position": [700, 300],
      "typeVersion": 1,
      "credentials": {
        "supabaseApi": {
          "id": "supabase-credentials",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "operation": "select",
        "table": "linkedin_posts",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "equal",
              "value": "pending"
            },
            {
              "keyName": "created_at",
              "condition": "dateAfter",
              "value": "={{ new Date(Date.now() - 30*60*1000).toISOString() }}"
            }
          ]
        },
        "options": {
          "queryName": "orderBy",
          "queryValue": "created_at.desc"
        }
      },
      "id": "get-pending-posts",
      "name": "Get Pending Posts",
      "type": "n8n-nodes-base.supabase",
      "position": [900, 300],
      "typeVersion": 1,
      "credentials": {
        "supabaseApi": {
          "id": "supabase-credentials",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=📰 **Bugünün LinkedIn Postları** ({{ $('Get Pending Posts').all().length }} adet)\n\n{{ $('Get Pending Posts').all().map((item, index) => `📝 **POST ${index + 1}:**\n${item.json.suggested_content}\n\n---\n`).join('') }}\n👆 Yukarıdaki postları onaylamak için seçin:",
        "additionalFields": {
          "replyMarkup": {
            "inlineKeyboard": {
              "rows": [
                {
                  "buttons": [
                    {
                      "text": "🚀 HEPSINI PAYLAŞ",
                      "callbackData": "approve_all_posts"
                    }
                  ]
                },
                {
                  "buttons": [
                    {
                      "text": "✏️ DÜZENLE",
                      "callbackData": "edit_posts"
                    },
                    {
                      "text": "❌ İPTAL ET",
                      "callbackData": "reject_all"
                    }
                  ]
                }
              ]
            }
          }
        }
      },
      "id": "send-telegram-approval",
      "name": "Send Telegram Approval",
      "type": "n8n-nodes-base.telegram",
      "position": [1100, 300],
      "typeVersion": 1.2,
      "credentials": {
        "telegramApi": {
          "id": "telegram-credentials",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "path": "telegram-response",
        "httpMethod": "POST",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "telegram-webhook",
      "name": "Telegram Response Webhook",
      "type": "n8n-nodes-base.webhook",
      "position": [100, 600],
      "typeVersion": 1,
      "webhookId": "telegram-response-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.callback_data }}",
              "operation": "equal",
              "value2": "approve_all_posts"
            }
          ]
        }
      },
      "id": "check-approval",
      "name": "Check Approval",
      "type": "n8n-nodes-base.if",
      "position": [300, 600],
      "typeVersion": 2
    },
    {
      "parameters": {
        "operation": "select",
        "table": "linkedin_posts",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "equal",
              "value": "pending"
            }
          ]
        },
        "options": {}
      },
      "id": "get-approved-posts",
      "name": "Get Approved Posts",
      "type": "n8n-nodes-base.supabase",
      "position": [500, 500],
      "typeVersion": 1,
      "credentials": {
        "supabaseApi": {
          "id": "supabase-credentials",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "text": "={{ $json.suggested_content }}",
        "additionalFields": {
          "shareCommentary": "={{ $json.suggested_content }}"
        }
      },
      "id": "linkedin-post",
      "name": "LinkedIn Post",
      "type": "n8n-nodes-base.linkedIn",
      "position": [700, 500],
      "typeVersion": 1,
      "credentials": {
        "linkedInOAuth2Api": {
          "id": "linkedin-credentials",
          "name": "LinkedIn Account"
        }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "table": "linkedin_posts",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "equal",
              "value": "={{ $('Get Approved Posts').item.json.id }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "posted",
            "posted_at": "={{ new Date().toISOString() }}",
            "linkedin_post_id": "={{ $json.id }}"
          }
        },
        "options": {}
      },
      "id": "update-posted-status",
      "name": "Update Posted Status",
      "type": "n8n-nodes-base.supabase",
      "position": [900, 500],
      "typeVersion": 1,
      "credentials": {
        "supabaseApi": {
          "id": "supabase-credentials",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=🎉 **LinkedIn Paylaşımı Tamamlandı!**\n\n📊 **{{ $('Get Approved Posts').all().length }} post paylaşıldı**\n⏰ **Zaman:** {{ new Date().toLocaleString('tr-TR') }}\n\n🔗 **Engagement takibi başladı**\n📈 **Sonuçları yarın raporlayacağım**",
        "additionalFields": {}
      },
      "id": "success-notification",
      "name": "Success Notification",
      "type": "n8n-nodes-base.telegram",
      "position": [1100, 500],
      "typeVersion": 1.2,
      "credentials": {
        "telegramApi": {
          "id": "telegram-credentials",
          "name": "Telegram Bot"
        }
      }
    }
  ],
