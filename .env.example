# ============================================
# Tech News Automation Platform
# Environment Variables Configuration
# ============================================

# ============================================
# AI Services (Required)
# ============================================

# Groq AI - Translation & Chat Widget
# Get your free API key: https://console.groq.com/
GROQ_API_KEY=gsk_your_key_here

# Firecrawl - Web Scraping
# Get your free API key: https://firecrawl.dev/
# Free tier: 500 requests/month
FIRECRAWL_API_KEY=fc-your_key_here

# Gemini AI (Google) - Manual Article Scraping
# Get your free API key: https://aistudio.google.com/app/apikey
# Free tier: Generous limits for Gemini 2.0 Flash
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# Database (Required)
# ============================================

# Supabase - PostgreSQL Database
# Get your project credentials: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...your_service_key_here

# ============================================
# Telegram Bot (Required for Notifications)
# ============================================

# Telegram Bot Token
# Get from @BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Your Telegram Chat ID
# Get from @userinfobot: https://t.me/userinfobot
TELEGRAM_CHAT_ID=123456789

# ============================================
# Security (Recommended for Production)
# ============================================

# API Secret for telegram-control endpoint
# Generate: openssl rand -hex 32
TELEGRAM_CONTROL_API_SECRET=your_random_64_character_secret_key_here

# ============================================
# GitHub Integration (Optional)
# ============================================

# GitHub Personal Access Token
# For triggering workflows from Telegram/API
# Create: Settings → Developer settings → Personal access tokens → Tokens (classic)
# Scopes needed: repo, workflow
GITHUB_TOKEN=ghp_your_token_here

# Repository name (format: username/repository)
GITHUB_REPOSITORY=username/My-Site

# ============================================
# n8n Workflow Integration (Required for LinkedIn Posts)
# ============================================

# n8n Workflow Webhooks
# These are configured in your n8n instance
# Format: https://your-n8n-instance.app.n8n.cloud/webhook/[path]

# Main LinkedIn Digest Workflow (handles schedule + manual + callbacks)
N8N_LINKEDIN_WORKFLOW_WEBHOOK=https://your-n8n-instance.app.n8n.cloud/webhook/linkedin-digest

# Manual Digest Creation Trigger (deprecated - use main workflow)
# N8N_MANUAL_DIGEST_WEBHOOK=https://your-n8n-instance.app.n8n.cloud/webhook/linkedin-digest-manual

# Callback Handler for Telegram buttons (deprecated - use main workflow)
# N8N_CALLBACK_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/linkedin-digest-callback

# ============================================
# LinkedIn Integration (n8n OAuth - DO NOT SET MANUALLY)
# ============================================

# LinkedIn OAuth is handled by n8n's built-in OAuth2 credential system
# Configure in n8n: Credentials → Add → LinkedIn OAuth2
# Required scopes: w_member_social (for posting)
# These tokens are managed by n8n, NOT stored here

# ============================================
# Email Services (Optional)
# ============================================

# EmailJS - Newsletter System
# Get credentials: https://www.emailjs.com/
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# ============================================
# Analytics (Optional)
# ============================================

# Vercel Analytics
VERCEL_ANALYTICS_ID=your_analytics_id

# Google Analytics
GA_TRACKING_ID=G-XXXXXXXXXX

# ============================================
# Site Configuration
# ============================================

# Your site URL (used in links and notifications)
NEXT_PUBLIC_SITE_URL=https://cemkoyluoglu.codes
SITE_URL=https://cemkoyluoglu.codes

# Node Environment
NODE_ENV=development

# ============================================
# Development Only
# ============================================

# Port for dev server (default: 5173)
PORT=5173

# Enable debug logging
DEBUG=false

# ============================================
# Deployment Guide
# ============================================
# 
# 1. LOCAL DEVELOPMENT:
#    - Copy this file to .env
#    - Fill in your actual values
#    - Never commit .env to git (it's in .gitignore)
# 
# 2. VERCEL (Production):
#    Project Settings → Environment Variables
#    Required:
#    - TELEGRAM_BOT_TOKEN
#    - TELEGRAM_CHAT_ID
#    - NEXT_PUBLIC_SUPABASE_URL
#    - SUPABASE_SERVICE_ROLE_KEY
#    - N8N_LINKEDIN_WORKFLOW_WEBHOOK
#    - GITHUB_TOKEN (for triggering manual article scraper)
#    - GITHUB_REPOSITORY
# 
# 3. GITHUB ACTIONS:
#    Repository Settings → Secrets → Actions
#    Required:
#    - GROQ_API_KEY
#    - FIRECRAWL_API_KEY
#    - GEMINI_API_KEY
#    - NEXT_PUBLIC_SUPABASE_URL
#    - SUPABASE_SERVICE_ROLE_KEY
#    - TELEGRAM_BOT_TOKEN
#    - TELEGRAM_CHAT_ID
# 
# 4. n8n:
#    Credentials → Add Credential
#    - LinkedIn OAuth2 (for posting)
#    - Telegram (bot token)
#    - Supabase (URL + service key)
#    - OpenAI (API key - for digest generation)
# 
# 5. Free tier limits:
#    - Groq: Unlimited requests (free)
#    - Firecrawl: 500 requests/month
#    - Gemini: Generous free tier (Gemini 2.0 Flash)
#    - OpenAI: $100 free credit (expires after 3 months)
#    - Supabase: 500MB database, 2GB bandwidth
#    - Vercel: 100GB bandwidth, unlimited requests
#    - Telegram: 30 messages/second
#    - n8n: 20,000 workflow executions/month (free tier)
# 
# 6. Security best practices:
#    - Use strong random keys for secrets
#    - Rotate keys every 90 days
#    - Use different keys for dev/prod
#    - Enable 2FA on all services
#    - Never share tokens in screenshots or logs
# 
# ============================================
