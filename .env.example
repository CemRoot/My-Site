# ============================================
# SENTRY ERROR TRACKING & MONITORING
# ============================================
# Get your DSN from: https://sentry.io/settings/projects/
# Format: https://<key>@<organization>.ingest.sentry.io/<project-id>

# Frontend Sentry Configuration
VITE_SENTRY_DSN=your_sentry_dsn_here
VITE_SENTRY_ENVIRONMENT=production
VITE_APP_VERSION=1.0.0

# Backend Sentry Configuration (for API routes)
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=production

# Sentry Auth Token (for uploading source maps - optional but recommended)
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here
SENTRY_ORG=your_organization_slug
SENTRY_PROJECT=your_project_slug

# ============================================
# GROQ API (AI Chat)
# ============================================
GROQ_API_KEY=your_groq_api_key_here

# ============================================
# SUPABASE DATABASE
# ============================================
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key

# ============================================
# TELEGRAM BOT
# ============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ============================================
# VERCEL (Automatically set by Vercel)
# ============================================
# VERCEL_URL=automatically_set_by_vercel
# VERCEL_ENV=automatically_set_by_vercel
# VERCEL_GIT_COMMIT_SHA=automatically_set_by_vercel
# VERCEL_REGION=automatically_set_by_vercel

# ============================================
# OTHER SERVICES
# ============================================
# Add other API keys and secrets as needed
