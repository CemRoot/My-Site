# ============================================
# SUPABASE DATABASE
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your_service_role_key

# ============================================
# AI SERVICES
# ============================================
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here
FIRECRAWL_API_KEY=fc-your_firecrawl_api_key_here

# --- Groq model overrides (optional) ---------------------------------------
# Groq retires models on a schedule and the API then returns 404 for them
# (llama-3.1-8b-instant and llama-3.3-70b-versatile were both retired on
# 2026-08-16). Leave these unset to use the defaults in
# lib/groqModels.js; set one to route around a decommission
# immediately, without waiting for a code change. In GitHub Actions these are
# repository *variables* (vars.*), not secrets — they are not sensitive.
# Verify any value with: npm run check:groq-models
# GROQ_PRIMARY_MODEL=openai/gpt-oss-20b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
# GROQ_LAST_RESORT_MODEL=openai/gpt-oss-120b
# GROQ_ENHANCEMENT_MODEL=openai/gpt-oss-20b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_PARSER_MODEL=openai/gpt-oss-20b        # called with GROQ_PARSER_API_KEY
# GROQ_LINKEDIN_MODEL=openai/gpt-oss-120b
# CHAT_GROQ_MODEL=openai/gpt-oss-120b          # live site chat (Vercel)
# CHAT_GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Fail the run when the Groq model list itself is unreachable (default: warn).
# STRICT_GROQ_MODEL_CHECK=false

# ============================================
# TELEGRAM BOT
# ============================================
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...your_bot_token
TELEGRAM_CHAT_ID=your_chat_id_here
# Webhook: openssl rand -hex 32 — Vercel + local same value; then npm run telegram:webhook-setup
TELEGRAM_WEBHOOK_SECRET=

# ============================================
# SENTRY ERROR TRACKING & MONITORING
# ============================================
VITE_SENTRY_DSN=https://key@org.ingest.sentry.io/project
VITE_SENTRY_ENVIRONMENT=production
VITE_APP_VERSION=1.0.0
SENTRY_DSN=https://key@org.ingest.sentry.io/project
SENTRY_ENVIRONMENT=production
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here
SENTRY_ORG=your_organization_slug
SENTRY_PROJECT=your_project_slug

# ============================================
# EMAILJS (Contact Form)
# ============================================
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here

# ============================================
# SECURITY (Production)
# ============================================
TELEGRAM_CONTROL_API_SECRET=generate_with_openssl_rand_hex_32
DEPLOYMENT_WEBHOOK_SECRET=generate_random_hex

# ============================================
# GITHUB INTEGRATION
# ============================================
GITHUB_TOKEN=ghp_your_github_token
GITHUB_REPOSITORY=CemRoot/My-Site

# ============================================
# n8n WORKFLOW AUTOMATION
# ============================================
N8N_LINKEDIN_WORKFLOW_WEBHOOK=https://your-n8n.app/webhook/...
N8N_CHATBOT_WEBHOOK=https://your-n8n.app/webhook/...

# ============================================
# VERCEL (Automatically set by Vercel)
# ============================================
# VERCEL_URL=automatically_set_by_vercel
# VERCEL_ENV=automatically_set_by_vercel
# VERCEL_GIT_COMMIT_SHA=automatically_set_by_vercel
# VERCEL_REGION=automatically_set_by_vercel
# VERCEL_TOKEN=your_vercel_token (for status monitoring)
# VERCEL_PROJECT_ID=your_project_id (for status monitoring)
